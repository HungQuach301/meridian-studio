{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "resolveJsonModule": true
  },
  "include": [
    "scripts/**/*.ts",
    "genres/data-explainer/canvas-spike.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
